{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "types": [
      "node",
      "jest",
      "js-yaml"
    ]
  },
  "include": [
    "scripts/**/*",
    "types/**/*",
    "__test__/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}